# ============================================================
# The Complete Privacy Stack — Configuration
# ============================================================
# This file is auto-generated by the setup wizard.
# All passwords are randomly generated — no manual editing needed.
#
# To re-run the wizard: sudo bash scripts/setup.sh
# To regenerate passwords: delete .env and re-run setup
# ============================================================

# ---- GENERAL ----
DOMAIN=
SERVER_IP=
ACME_EMAIL=

# ---- ENABLED SERVICES ----
# Docker Compose reads this to determine which services to start.
# Profiles: photos, docs, media, dns, passwords, monitoring, dashboard, vpn
COMPOSE_PROFILES=photos,docs,media,dns,passwords,monitoring,dashboard,vpn

# ---- DIRECTORIES ----
# Where to store your data. Use absolute paths.
DATA_DIR=/srv/privacy-stack
UPLOAD_DIR=/srv/privacy-stack/immich/upload
MEDIA_DIR=/srv/privacy-stack/media
PAPERLESS_CONSUME_DIR=/srv/privacy-stack/paperless/consume
PAPERLESS_EXPORT_DIR=/srv/privacy-stack/paperless/export

# ---- IMMICH (Photos) ----
IMMICH_DB_USER=postgres
IMMICH_DB_PASSWORD=CHANGE_ME_immich_db_password
IMMICH_DB_NAME=immich

# ---- PAPERLESS-NGX (Documents) ----
PAPERLESS_DB_PASSWORD=CHANGE_ME_paperless_db_password
PAPERLESS_DB_USER=postgres
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=CHANGE_ME_paperless_admin
PAPERLESS_SECRET_KEY=CHANGE_ME_random_secret_key_at_least_50_chars
PAPERLESS_URL=http://localhost:8000

# ---- JELLYFIN (Media) ----
JELLYFIN_URL=http://localhost:8096

# ---- VAULTWARDEN (Passwords) ----
# Admin token: used to access /admin panel
VAULTWARDEN_ADMIN_TOKEN=CHANGE_ME_vaultwarden_admin_token
VAULTWARDEN_URL=https://vault.yourdomain.com
VAULTWARDEN_SIGNUPS=true

# ---- TAILSCALE (Remote Access) ----
# Generate an auth key at: https://login.tailscale.com/admin/settings/keys
# Leave blank to authenticate interactively: docker exec tailscale tailscale up
TAILSCALE_AUTHKEY=

# ---- BACKUPS ----
BACKUP_DIR=/srv/backups/privacy-stack
BACKUP_CRON=
